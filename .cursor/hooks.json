{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "bash .cursor/hooks/cur-kit stop",
        "timeout": 900,
        "loop_limit": 25
      }
    ],
    "sessionStart": [
      {
        "command": "bash .cursor/hooks/cur-kit session-start",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bash .cursor/hooks/cur-kit before-submit",
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "bash .cursor/hooks/cur-kit after-response",
        "timeout": 10
      }
    ]
  }
}
